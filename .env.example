# ─── Database ─────────────────────────────────────────────────
DB_NAME=trungnguyen_hrm_lite
DB_ROOT_PASSWORD=rootpassword123
DB_USER=htttdn_user
DB_PASSWORD=htttdn_pass123

# ─── Backend ──────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://htttdn_user:htttdn_pass123@db:3306/trungnguyen_hrm_lite
# BẮT BUỘC đổi: chuỗi ngẫu nhiên dài (vd: python -c "import secrets; print(secrets.token_urlsafe(48))").
# Để trống hoặc giữ giá trị mẫu thì backend sinh khóa tạm, token mất hiệu lực mỗi lần khởi động lại.
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Quản lý thuộc phòng ban này được xem/xử lý nhân sự toàn công ty (mặc định PB02 - Phòng Nhân sự)
HR_DEPARTMENT_CODE=PB02
# Origin được phép gọi API trực tiếp (frontend mặc định gọi qua proxy cùng origin)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Frontend (nếu cần) ───────────────────────────────────────
VITE_API_URL=http://localhost:8000
